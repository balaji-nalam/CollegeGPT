# ==========================================
# CollegeGPT — Environment Configuration
# Production Template: Supabase PostgreSQL + Supabase Storage
# ==========================================

# Server & Environment
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:3000

# Primary PostgreSQL Database & Vector Engine (Supabase / Render)
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=

# Authentication (JWT)
JWT_SECRET=your_strong_production_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=7d

# Initial Production Administrator Provisioning
# Admin accounts CANNOT be registered publicly; they are provisioned safely via seed script or environment.
ADMIN_NAME="College Administrator"
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=change_this_admin_password_in_production!

# Embedding Engine Configuration
# Supported providers: google | openai | openrouter | local
EMBEDDING_PROVIDER=google
# Defined Production Embedding Model
EMBEDDING_MODEL=text-embedding-004
# Vector Dimension matching EMBEDDING_MODEL strictly (768 for text-embedding-004)
EMBEDDING_DIMENSION=768

# RAG Retrieval Configuration
TOP_K=5
SIMILARITY_THRESHOLD=0.15
MAX_CONTEXT_CHARS=4000
MAX_HISTORY_MESSAGES=10

# AI / LLM Providers (for RAG Generation)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Document Storage Configuration
# Options: supabase | local
STORAGE_PROVIDER=supabase
UPLOAD_DIR=./uploads/documents

# Supabase Storage Configuration (Production Document Storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=collegegpt-documents
